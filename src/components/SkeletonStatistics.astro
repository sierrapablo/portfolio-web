---
import '@/styles/statistics.css';
---

<section id="statistics" class="fade-in delay-2">
  <h2>GitHub Statistics</h2>
  <div slot="fallback" class="statistics-container skeleton-stats-container">
    <div class="stats-card skeleton-stats-card">
      <div class="stats-header">
        <h3>Contributions</h3>
        <span class="period">Loading data...</span>
      </div>
      <div class="stats-summary">
        <div class="stat-item">
          <span class="stat-value skeleton-stat-value">0000</span>
          <span class="stat-label">Total Contributions</span>
        </div>
      </div>
      <div class="heatmap-container skeleton-heatmap-container">Loading heatmap...</div>
    </div>
  </div>
</section>
