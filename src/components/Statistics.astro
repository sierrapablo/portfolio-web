---
import '@/styles/statistics.css';
import { getContributions } from '@/lib/getContributions';
import { GH_YEAR } from '@/data/properties.json';

const data = await getContributions(GH_YEAR);
const days = data?.days || [];
const totalContributions = data?.total || 0;
---

<section id="statistics" class="fade-in delay-2">
  <h2>GitHub Statistics</h2>
  <div class="statistics-container">
    <div class="stats-card">
      <div class="stats-header">
        <h3>Contributions</h3>
        <span class="period">{GH_YEAR === 'last' || !GH_YEAR ? 'Last 365 days' : GH_YEAR}</span>
      </div>

      <div class="stats-summary">
        <div class="stat-item">
          <span class="stat-value">{totalContributions}</span>
          <span class="stat-label">Total Contributions</span>
        </div>
      </div>

      <div class="heatmap-container">
        <div class="heatmap">
          {
            days.map((day) => (
              <div
                class="contribution-day"
                data-level={day.level}
                title={`${day.count} contributions on ${day.date}`}
              />
            ))
          }
        </div>
      </div>

      <div class="heatmap-legend">
        <span>Less</span>
        <div class="legend-scale">
          <div class="contribution-day" data-level="0"></div>
          <div class="contribution-day" data-level="1"></div>
          <div class="contribution-day" data-level="2"></div>
          <div class="contribution-day" data-level="3"></div>
          <div class="contribution-day" data-level="4"></div>
        </div>
        <span>More</span>
      </div>
    </div>
  </div>
</section>
